# Settings for docker compose and the backend. Create your own copy with:
#
#   scripts/init-env.sh     (copies this file to .env and generates a strong POSTGRES_PASSWORD)
#
# .env is gitignored: never commit it. In production, inject these as environment variables from your
# platform's secret store (e.g. AWS Secrets Manager / SSM, Kubernetes secrets) instead of a file.
# Every variable is described in the README section "Configuration & secrets".

# --- PostgreSQL ('postgres' profile) ---
POSTGRES_DB=subscriptions
POSTGRES_USER=subscriptions
# SECRET. Required, no default. Leave empty here; scripts/init-env.sh writes a value from `openssl rand -hex 24`.
POSTGRES_PASSWORD=

# --- AWS SNS/SQS ('aws' profile). docker compose points the backend at LocalStack. ---
AWS_REGION=us-east-1
# Use the *_ARN / *_URL variants instead of names to skip the start-up lookups.
SNS_ORDER_TOPIC_NAME=order-events
SNS_ORDER_TOPIC_ARN=
SQS_ORDER_QUEUE_NAME=order-processing
SQS_ORDER_QUEUE_URL=
SQS_ORDER_DLQ_NAME=order-processing-dlq
SQS_ORDER_DLQ_URL=
# Receives before a failing message is moved to the DLQ (LocalStack's RedrivePolicy is created from it).
MESSAGING_MAX_RECEIVE_COUNT=3

# --- Billing ---
# Spring cron (second minute hour day-of-month month day-of-week) and its time zone.
BILLING_CRON="0 0 6 * * *"
BILLING_ZONE=UTC
BILLING_SCHEDULER_ENABLED=true

# --- Simulated payment step ---
# NONE | TRANSIENT | PERMANENT, optionally limited to one plan code (e.g. MEAL-KIT).
FAILURE_INJECTION_MODE=NONE
FAILURE_INJECTION_PLAN_CODE=
PROCESSING_SIMULATED_LATENCY=400ms

# --- HTTP ---
# Origins allowed to call the API cross-origin (comma-separated). The bundled UI is same-origin via nginx.
CORS_ALLOWED_ORIGINS=http://localhost:3000
GRAPHIQL_ENABLED=true
SEED_DEMO_DATA=true

# --- Ports published on 127.0.0.1 by docker compose ---
FRONTEND_PORT=3000
BACKEND_PORT=8080
LOCALSTACK_PORT=4566
