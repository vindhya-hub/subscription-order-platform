# Frontend settings. Every VITE_* value is compiled into the public JavaScript bundle, so these are never secrets
# and nothing secret may ever be put in a VITE_* variable. Copy to .env.local to override (gitignored).

# GraphQL endpoint the browser calls. Keep it relative so the Vite dev proxy (npm run dev) and nginx (Docker image)
# forward it to the backend same-origin. An absolute URL calls another host directly; the backend must then list
# this app's origin in CORS_ALLOWED_ORIGINS.
VITE_GRAPHQL_URL=/graphql

# Dev server only (not bundled): where `npm run dev` proxies /graphql and /graphiql.
VITE_DEV_PROXY_TARGET=http://localhost:8080

# How often, in milliseconds, orders, dead letters and queue statistics refresh.
VITE_POLL_INTERVAL_MS=2000
